{
  "manifest_version": 3,
  "name": "Passphrase Generator",
  "version": "1.0.0",
  "description": "Generate strong, memorable passphrases offline using the EFF diceware wordlist.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Generate a passphrase",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}